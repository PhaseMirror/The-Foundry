{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UnifiedWitness",
  "type": "object",
  "required": [
    "action_id",
    "compliance_evidence",
    "contractivity_score",
    "execution_receipt",
    "timestamp",
    "veto_status",
    "witness_id"
  ],
  "properties": {
    "action_id": {
      "type": "string"
    },
    "compliance_evidence": {
      "type": "string"
    },
    "contractivity_score": {
      "type": "number",
      "format": "double"
    },
    "execution_receipt": true,
    "timestamp": {
      "type": "string"
    },
    "veto_status": {
      "type": "string"
    },
    "witness_id": {
      "type": "string"
    }
  }
}