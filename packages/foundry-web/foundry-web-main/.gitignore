# Build output.
/target/
**/target/
/.prism/

# Next.js build state. `tsconfig.tsbuildinfo` is an incremental compiler cache:
# it goes stale the moment a source file changes, so a stale copy that survives
# a checkout is worse than no copy at all. Regenerated by `next build`.
/.next/
/node_modules/
/tsconfig.tsbuildinfo
/coverage/

# Local environment. `.env.example` is the tracked contract; the real file is
# not, and must never be.
.env*
!.env.example
*.log

# The scaling harness writes its fits here; the committed artifact is the
# report in `oracles/`, not the raw run.
/reports/
criterion/

# cargo-fuzz working state. The corpus that matters is committed under
# `fuzz/corpus/`; the rest is machine-local.
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/target/

# Editor and OS noise.
.DS_Store
*.swp
*~
.idea/
.vscode/

# `Cargo.lock` is NOT ignored: the resolved version of every oracle is part of
# the claim made against it (R11).
